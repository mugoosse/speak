<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.mgo.speak</string>
    <!-- Fixed install path, so this keeps working across rebuilds.
         Login Items in System Settings does the same job; use one or the
         other, not both. -->
    <key>ProgramArguments</key>
    <array><string>/Applications/Speak.app/Contents/MacOS/Speak</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardErrorPath</key><string>/tmp/speak.err</string>
</dict>
</plist>
